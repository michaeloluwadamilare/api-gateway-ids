    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jest": "^28.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.9"
  }
